{
  "manifest_version": 3,
  "name": "Download Manager Integration",
  "version": "1.12.2",
  "description": "Send downloads, links and YouTube / TikTok videos to the Download Manager app.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["downloads", "contextMenus", "storage", "tabs", "notifications", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["formats.js", "background.js"]
  },
  "action": {
    "default_title": "Download Manager",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "options_ui": { "page": "popup.html#settings", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["formats.js", "content-links.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.tiktok.com/*"],
      "js": ["quality.js", "content-media.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "download-manager@ayad0net", "strict_min_version": "121.0" }
  }
}
