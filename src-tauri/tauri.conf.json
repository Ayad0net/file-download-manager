{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Download Manager",
  "version": "1.13.1",
  "identifier": "com.ayadkorial.downloadmanager",
  "build": {
    "frontendDist": "../frontend",
    "beforeBuildCommand": "bun run build:sidecar",
    "beforeDevCommand": "bun run build:sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Download Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 22, "y": 26 },
        "label": "main",
        "visible": false,
        "backgroundColor": "#07070b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../extension/": "extension/"
    },
    "externalBin": [
      "binaries/dm-backend"
    ],
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent File",
        "description": "BitTorrent file",
        "role": "Viewer",
        "mimeType": "application/x-bittorrent"
      }
    ],
    "macOS": {
      "files": {
        "Resources/torrent.icns": "icons/torrent.icns"
      }
    },
    "resources": {
      "icons/torrent.ico": "torrent.ico"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/com.ayadkorial.downloadmanager.xml": "linux/torrent-mime.xml",
          "/usr/share/icons/hicolor/16x16/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/16.png",
          "/usr/share/icons/hicolor/24x24/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/24.png",
          "/usr/share/icons/hicolor/32x32/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/32.png",
          "/usr/share/icons/hicolor/48x48/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/48.png",
          "/usr/share/icons/hicolor/64x64/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/64.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/256.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/512.png"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/mime/packages/com.ayadkorial.downloadmanager.xml": "linux/torrent-mime.xml",
          "/usr/share/icons/hicolor/16x16/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/16.png",
          "/usr/share/icons/hicolor/24x24/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/24.png",
          "/usr/share/icons/hicolor/32x32/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/32.png",
          "/usr/share/icons/hicolor/48x48/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/48.png",
          "/usr/share/icons/hicolor/64x64/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/64.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/256.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/com.ayadkorial.downloadmanager.torrent.png": "icons/torrent/512.png"
        }
      }
    }
  }
}
