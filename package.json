{
  "name": "download-manager",
  "version": "1.0.0",
  "description": "Web-based file download manager",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch backend/src/index.ts",
    "start": "bun run backend/src/index.ts",
    "build": "tsc -p backend/tsconfig.json",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "vendor": "rm -rf frontend/vendor/fontawesome && mkdir -p frontend/vendor/fontawesome && cp -R node_modules/@fortawesome/fontawesome-free/css node_modules/@fortawesome/fontawesome-free/webfonts frontend/vendor/fontawesome/",
    "postinstall": "bun run vendor",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "sql.js": "^1.11.0",
    "hono": "^4.7.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.5.1",
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.8.0"
  },
  "trustedDependencies": [
    "sql.js"
  ]
}
