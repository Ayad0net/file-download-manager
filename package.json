{
  "name": "download-manager",
  "version": "1.4.0",
  "description": "Web-based file download manager",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch backend/src/index.ts",
    "start": "bun run backend/src/index.ts",
    "build": "tsc -p backend/tsconfig.json",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json",
    "build:sidecar": "bun scripts/build-sidecar.ts",
    "vendor": "bun scripts/vendor.ts",
    "postinstall": "bun run vendor",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "version:bump": "bun scripts/bump-version.ts"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "parse-torrent": "11.0.24",
    "sql.js": "^1.11.0",
    "uuid": "^11.1.0",
    "webrtc-polyfill": "file:./stubs/webrtc-polyfill",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "6.5.1",
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.8.0"
  },
  "trustedDependencies": [
    "sql.js"
  ],
  "overrides": {
    "webrtc-polyfill": "file:./stubs/webrtc-polyfill"
  }
}
